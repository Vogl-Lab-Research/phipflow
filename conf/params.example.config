params {
    base_dir = '/lisc/data/scratch/ccr/CR_projects/phiper'

    project_name  = '<project>'
    metadata_file = '<project>_metadata.csv'

    exist_file  = 'exist.csv'
    fold_file   = 'fold.csv'

    // Optional full paths to inputs stored outside <base_dir>/<project_name>/.
    // If null, Data/<exist_file>, Data/<fold_file> and Metadata/<metadata_file> are used.
    // exist_path    = '/path/to/exist.csv'
    // fold_path     = '/path/to/fold.csv'
    // metadata_path = '/path/to/metadata.csv'

    // Optional. If null, defaults to <project_name>.parquet.
    out_parquet = null

    // Optional. These are the metadata group columns to analyze.
    // Each value is passed to 02-run_phiper_analysis.R as ACTIVE_GROUP.
    // If null, Nextflow will use all names listed in <project_name>/R/group_config.R group_definitions.
    group_cols = 'group_test,group_combined'

    // Optional override for 03-render_phiper_reports.R GROUP_COLS.
    // If null or omitted, reports use the same final values as group_cols.
    report_group_cols = null

    all                    = 'FALSE'
    default_longitudinal   = 'FALSE'
    manual_comparison_file = 'NULL'

    // Optional peptide-library filter (R expressions; a list is combined with AND).
    // peptide_filter = ["species != 'Homo sapiens'", "is_EBV"]
    // Consider a separate results_name per filter, e.g. results_name = 'results_EBV'
}
